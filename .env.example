# Copy this file to .env and fill in your values.
# Get a TMDB API key: https://www.themoviedb.org/settings/api
#
# Vite exposes VITE_* variables to the browser — do not put true secrets here.

VITE_TMDB_API_KEY=

# Server-only variables for Neon + auth. Do not prefix these with VITE_.
DATABASE_URL=
AUTH_COOKIE_NAME=tm_session
AUTH_SESSION_TTL_DAYS=30
